{
    "swagger": "2.0",
    "info": {
        "description": "Go-сервис, который предоставляет HTTP и gRPC API и внутри ходит во внешний фильм-стенд",
        "title": "movie api",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Ищет и возвращает последний добавленный фильм на стенде",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Получить последний фильм",
                "responses": {
                    "200": {
                        "description": "Успешный ответ"
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Загружает фильмы с указанными ID (от from до to)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Загрузить диапазон фильмов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Начальный ID фильма",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Конечный ID фильма",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный ответ"
                    }
                }
            }
        }
    }
}